{
  "name": "laa-express-typescript-template",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "main": "public/app.js",
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "start": "node public/app.js",
    "clean": "rimraf public",
    "build": "yarn clean && yarn build:ts && node public/esbuild.js",
    "lint": "yarn eslint . --fix",
    "dev": "yarn build:ts && concurrently \"tsc --watch\" \"node public/esbuild.js --watch\" \"nodemon\"",
    "deploy": "./scripts/deploy.sh",
    "prepare": "husky",
    "tsc": "tsc --noEmit",
    "build:ts": "tsc",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "./node_modules/.bin/mocha",
    "test:e2e": "yarn playwright test --config=tests/playwright/playwright.config.ts",
    "coverage": "c8 yarn test:unit --check-coverage"
  },
  "engines": {
    "node": "26.9.0"
  },
  "dependencies": {
    "@ministryofjustice/frontend": "^11.0.1",
    "axios": "1.20.0",
    "body-parser": "^2.3.0",
    "chalk": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "~1.4.6",
    "csrf-sync": "^4.2.1",
    "debug": "~4.4.3",
    "dotenv": "^18.0.0",
    "express": "^5.2.0",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.0",
    "figlet": "^1.11.4",
    "fs-extra": "^11.4.0",
    "govuk-frontend": "^6.5.0",
    "helmet": "^8.3.0",
    "http-errors": "~2.0.0",
    "i18next": "^26.4.2",
    "libphonenumber-js": "^1.13.13",
    "moment": "^2.31.0",
    "morgan": "~1.12.1",
    "nunjucks": "^3.2.4",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/chai": "^5.2.3",
    "@types/compression": "^1.7.5",
    "@types/connect-livereload": "^0.6.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.1",
    "@types/figlet": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/livereload": "^0.9.5",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.5.0",
    "@types/nunjucks": "^3.2.6",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "axe-core": "^4.13.0",
    "c8": "^12.0.0",
    "chai": "^6.2.0",
    "chokidar": "5.0.0",
    "concurrently": "^10.0.5",
    "connect-livereload": "^0.6.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.10.0",
    "eslint-config-love": "^157.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.3.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.5.0",
    "livereload": "^0.10.2",
    "middleware-axios": "^3.0.0",
    "mocha": "^12.0.1",
    "msw": "^2.15.0",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass": "^1.104.1",
    "sass-embedded": "^1.104.1",
    "sinon": "^22.1.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix"
  },
  "packageManager": "yarn@4.9.2"
}
