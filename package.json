{
  "name": "laa-express-typescript-template",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "main": "public/app.js",
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "start": "node public/app.js",
    "clean": "rimraf public",
    "build": "yarn clean && yarn build:ts && node public/esbuild.js",
    "lint": "yarn eslint . --fix",
    "dev": "yarn build:ts && concurrently \"tsc --watch\" \"node public/esbuild.js --watch\" \"nodemon\"",
    "deploy": "./scripts/deploy.sh",
    "prepare": "husky",
    "tsc": "tsc --noEmit",
    "build:ts": "tsc",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "./node_modules/.bin/mocha",
    "test:e2e": "yarn playwright test --config=tests/playwright/playwright.config.ts",
    "test:accessibility": "yarn test:e2e --grep @accessibility",
    "coverage": "c8 yarn test:unit --check-coverage"
  },
  "engines": {
    "node": "26.9.0"
  },
  "dependencies": {
    "@ministryofjustice/frontend": "^11.0.1",
    "axios": "1.20.0",
    "body-parser": "^2.4.0",
    "compression": "^1.8.2",
    "csrf-sync": "^4.2.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.0",
    "govuk-frontend": "^6.6.0",
    "helmet": "^8.3.0",
    "http-errors": "~2.0.1",
    "i18next": "^26.4.5",
    "middleware-axios": "^3.0.0",
    "moment": "^2.31.0",
    "morgan": "~1.12.1",
    "nunjucks": "^3.2.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/chai": "^5.2.3",
    "@types/compression": "^1.7.5",
    "@types/connect-livereload": "^0.6.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.6.5",
    "@types/nunjucks": "^3.2.6",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.4",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "concurrently": "^10.0.6",
    "connect-livereload": "^0.6.1",
    "esbuild": "^0.28.2",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.12.0",
    "eslint-config-love": "^158.0.0",
    "eslint-plugin-jsdoc": "^65.3.4",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "msw": "^3.0.3",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.64.1",
    "rimraf": "^6.1.3",
    "sass": "^1.105.1",
    "sass-embedded": "^1.105.1",
    "sinon": "^22.1.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix"
  },
  "packageManager": "yarn@4.9.2"
}
