{
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025", "DOM"],
    "module": "NodeNext",
    "outDir": "public",
    "rootDir": ".",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmitOnError": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "#*": ["./*"]
    }
  },
  "include": [
    "src/**/*",
    "middleware/**/*",
    "utils/**/*.ts",
    "routes/**/*",
    "scripts/**/*.ts",
    "index.ts",
    "esbuild.ts",
    "config.ts",
    "types/**/*.ts",
    "tests/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": ["node_modules", "public"]
}
